# —— 推荐优先使用 DeepSeek（性价比最高，学习阶段成本最低）—— #
# DeepSeek API key（从 https://platform.deepseek.com/ 申请）
DEEPSEEK_API_KEY=sk-...

# —— 以下为其他 provider，按需填写 —— #

# 通义千问（阿里云 DashScope）：https://dashscope.console.aliyun.com/
# 使用方法：安装 langchain-openai，通过 ChatOpenAI 兼容接入
# DASHSCOPE_API_KEY=sk-...
# 示例代码：
#   from langchain_openai import ChatOpenAI
#   llm = ChatOpenAI(
#       model="qwen-plus",
#       base_url="https://dashscope.aliyuncs.com/compatible-mode/v1",
#       api_key=os.getenv("DASHSCOPE_API_KEY"),
#   )

# OpenAI 官方：https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...
# 如使用兼容 OpenAI 的第三方代理端点，可设置 base_url
# OPENAI_BASE_URL=https://api.openai.com/v1

# —— LangSmith 可观测（可选，调试阶段非常有用）—— #
# 申请地址：https://smith.langchain.com/
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2_pt_...
# LANGCHAIN_PROJECT=langchain-learning
